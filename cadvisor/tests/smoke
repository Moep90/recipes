#!/usr/bin/env bash
# cAdvisor answers through its Service with the version of the DaemonSet's
# image. Each pod, read through the API server's pod proxy, reports the
# working set of its own container with the pod's name, namespace and
# container name, which it takes from the node's cgroups and containerd, no
# other container label and no CPU series (RCP-446).
set -euo pipefail
ns=$(kubectl config view --minify -o jsonpath='{..namespace}')
image=$(kubectl -n "$ns" get daemonset cadvisor -o jsonpath='{.spec.template.spec.containers[0].image}')
ref=${image%%@*}
tag=${ref##*:}
fail() { echo "$1" >&2; exit 1; }

# The Service gets the ready pod as its endpoint a moment after the rollout.
for _ in $(seq 30); do
  out=$(kubectl get --raw "/api/v1/namespaces/$ns/services/cadvisor:http/proxy/metrics" 2>/dev/null || true)
  grep -q "^cadvisor_version_info{.*cadvisorVersion=\"v$tag\"" <<<"$out" && break
  sleep 2
done
grep -q "^cadvisor_version_info{.*cadvisorVersion=\"v$tag\"" <<<"$out" || fail "no cadvisor_version_info for v$tag through the Service cadvisor"

pods=$(kubectl -n "$ns" get pods -l name=cadvisor -o jsonpath='{.items[*].metadata.name}')
[[ -n $pods ]] || fail "no pod of the DaemonSet cadvisor"
for pod in $pods; do
  out=$(kubectl get --raw "/api/v1/namespaces/$ns/pods/$pod:8080/proxy/metrics")
  own=$(grep '^container_memory_working_set_bytes{' <<<"$out" \
    | grep -F "container_label_io_kubernetes_pod_name=\"$pod\"" \
    | grep -F "container_label_io_kubernetes_pod_namespace=\"$ns\"" \
    | grep -F 'container_label_io_kubernetes_container_name="cadvisor"' || true)
  [[ -n $own ]] || fail "$pod reports no container_memory_working_set_bytes for its container cadvisor"
  ! grep -q 'container_label_io_kubernetes_pod_uid=' <<<"$out" || fail "$pod labels metrics with io.kubernetes.pod.uid"
  ! grep -q '^container_cpu_usage_seconds_total{' <<<"$out" || fail "$pod reports container_cpu_usage_seconds_total"
done
echo "cAdvisor v$tag through the Service, and the working set of its own container from $pods, labelled with pod, namespace and container only, without CPU series."
